NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/conversation

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Native audio-to-audio conversation and interruption support.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-preview

# Fast agent reasoning and code-generation tool execution.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional current-information tool.
TAVILY_API_KEY=

# Optional Sarvam voices for the non-live /api/voice/synthesize endpoint.
# Gemini Live remains the native audio-to-audio provider for /ws/conversation.
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback
GITHUB_ACCESS_TOKEN=
